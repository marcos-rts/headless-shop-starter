{
  "kind": "collectionType",
  "collectionName": "produtos",
  "info": {
    "singularName": "produto",
    "pluralName": "produtos",
    "displayName": "Produto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string"
    },
    "descricao": {
      "type": "richtext"
    },
    "preco": {
      "type": "decimal"
    },
    "estoque": {
      "type": "integer"
    },
    "imagem": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "slug": {
      "type": "uid",
      "targetField": "nome"
    },
    "ativo": {
      "type": "boolean"
    },
    "categoria": {
      "type": "string"
    }
  }
}
